+// usesDefaultHTTPURLPolicy reports whether security.http.urls is the
+// built-in default rather than a user-supplied policy.
+func (c Config) usesDefaultHTTPURLPolicy() bool {
+	return slices.Equal(c.HTTP.URLs.patternsStrings, DefaultConfig.HTTP.URLs.patternsStrings)
+}
+
+// hostLookupTimeout bounds the resolution of a URL host name.
+const hostLookupTimeout = 2 * time.Second
+
+// resolvesToBlockedAddr reports whether the host name in rawURL resolves to
+// an address the default policy blocks. IP literals are left to the policy
+// itself; a name that cannot be resolved is not blocked here, because the
+// request could not reach any host either.
+func resolvesToBlockedAddr(rawURL string) bool {
+	pu, err := url.Parse(rawURL)
+	if err != nil {
+		return false
+	}
+	host := pu.Hostname()
+	if host == "" {
+		return false
+	}
+	if _, err := netip.ParseAddr(host); err == nil {
+		return false
+	}
+	if _, ok := parseInetAtonIPv4(host); ok {
+		return false
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), hostLookupTimeout)
+	defer cancel()
+	addrs, err := net.DefaultResolver.LookupNetIP(ctx, "ip", host)
+	if err != nil {
+		return false
+	}
+	for _, a := range addrs {
+		a = a.Unmap()
+		if a.IsLoopback() || a.IsPrivate() || a.IsUnspecified() ||
+			a.IsLinkLocalUnicast() || a.IsLinkLocalMulticast() || a.IsInterfaceLocalMulticast() {
+			return true
+		}
+	}
+	return false
+}
+
+// canonicalIPv4URL rewrites an integer/hex/octal IPv4 host in rawURL to its
+// canonical dotted-decimal form (inet_aton semantics), returning ok=false when
+// the host is a normal name or already dotted-decimal.
+func canonicalIPv4URL(rawURL string) (string, bool) {
+	u, err := url.Parse(rawURL)
+	if err != nil {
+		return "", false
+	}
+	host := u.Hostname()
+	ip, ok := parseInetAtonIPv4(host)
+	if !ok || ip.String() == host {
+		return "", false
+	}
+	if port := u.Port(); port != "" {
+		u.Host = ip.String() + ":" + port
+	} else {
+		u.Host = ip.String()
+	}
+	return u.String(), true
+}
+
+// parseInetAtonIPv4 parses the inet_aton IPv4 forms (1–4 dot-separated parts,
+// each decimal, octal "0..." or hex "0x..."), e.g. "2130706433", "0x7f.0.0.1".
+func parseInetAtonIPv4(host string) (netip.Addr, bool) {
+	if host == "" {
+		return netip.Addr{}, false
+	}
+	parts := strings.Split(host, ".")
+	if len(parts) > 4 {
+		return netip.Addr{}, false
+	}
+	vals := make([]uint64, len(parts))
+	for i, p := range parts {
+		v, ok := parseCInt(p)
+		if !ok {
+			return netip.Addr{}, false
+		}
+		vals[i] = v
+	}
+	maxLast := []uint64{0xffffffff, 0xffffff, 0xffff, 0xff}[len(parts)-1]
+	var n uint64
+	for i, v := range vals {
+		if i == len(parts)-1 {
+			if v > maxLast {
+				return netip.Addr{}, false
+			}
+			n |= v
+		} else {
+			if v > 0xff {
+				return netip.Addr{}, false
+			}
+			n |= v << (8 * (3 - i))
+		}
+	}
+	return netip.AddrFrom4([4]byte{byte(n >> 24), byte(n >> 16), byte(n >> 8), byte(n)}), true
+}
+
+func parseCInt(s string) (uint64, bool) {
+	base := 10
+	switch {
+	case len(s) >= 2 && s[0] == '0' && (s[1] == 'x' || s[1] == 'X'):
+		base, s = 16, s[2:]
+	case len(s) >= 2 && s[0] == '0':
+		base, s = 8, s[1:]
+	}
+	if s == "" {
+		return 0, false
+	}
+	v, err := strconv.ParseUint(s, base, 64)
+	if err != nil {
+		return 0, false
+	}
+	return v, true
+}
