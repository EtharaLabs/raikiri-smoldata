+	// A host can be written as an integer/hex/octal IPv4 literal
+	// (e.g. http://2130706433/ == http://127.0.0.1/) that has no dot and
+	// thus slips past IP-literal deny rules. Re-check the canonical form so
+	// the policy treats every encoding of the same address alike.
+	if canon, ok := canonicalIPv4URL(u); ok && !c.HTTP.URLs.Accept(canon) {
+		return deny(u)
+	}
+	// The default policy matches host names textually, so a name that
+	// resolves to a loopback, private, link-local or unspecified address
+	// (an /etc/hosts alias, a DNS record pointing inside the network)
+	// reaches the very hosts the policy blocks. Judge the default policy on
+	// where the name actually points. An explicit user policy is left alone:
+	// the user may deliberately allow such hosts.
+	if c.usesDefaultHTTPURLPolicy() && resolvesToBlockedAddr(u) {
+		return deny(u)
+	}
