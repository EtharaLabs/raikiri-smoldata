package main

// Held-out reproducer: loopback written in numeric encodings that carry no
// dotted-decimal prefix. Exits 1 if the default policy accepts any of them.

import (
	"fmt"
	"os"

	"github.com/gohugoio/hugo/config"
	"github.com/gohugoio/hugo/config/security"
)

func main() {
	pc, err := security.DecodeConfig(config.New())
	if err != nil {
		fmt.Println("ERROR:", err)
		os.Exit(2)
	}
	accepted := 0
	for _, u := range []string{
		"http://2130706433/",          // decimal 127.0.0.1
		"http://017700000001/",        // octal 127.0.0.1
		"http://0x7f000001:8080/x",    // hex 127.0.0.1 with a port
		"http://0x7f.1/",              // hex first part, short form
	} {
		if pc.CheckAllowedHTTPURL(u) == nil {
			fmt.Println("ACCEPTED:", u)
			accepted++
		}
	}
	if accepted > 0 {
		os.Exit(1)
	}
	fmt.Println("CLEAN: every loopback encoding denied")
}
